@inproceedings{kota2018automated,
  title = {Automated Detection of Handwritten Whiteboard Content in Lecture Videos for Summarization},
  author = {Kota, Bhargava Urala and Davila, Kenny and Stone, Alexander and Setlur, Srirangaraj and Govindaraju, Venu},
  booktitle = {2018 16th International Conference on Frontiers in Handwriting Recognition (ICFHR)},
  pages = {19--24},
  year = {2018},
  organization = {IEEE},
  doi = {10.1109/ICFHR-2018.2018.00013},
  abbr = {ICFHR},
  bibtex_show = {true},
  pdf = {https://par.nsf.gov/servlets/purl/10113238},
  abstract = {A scene-text detector is adapted to find handwritten text, math, and sketches on a whiteboard, including content occluded by the lecturer. The detections are used to summarize the lecture. The work also released timestamped bounding-box annotations for the AccessMath dataset.}
}

