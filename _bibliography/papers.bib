@inproceedings{jawade2024proxyfusion,
  title = {ProxyFusion: Face Feature Aggregation Through Sparse Experts},
  author = {Jawade, Bhavin and Stone, Alexander and Mohan, Deen Dayal and Wang, Xiao and Setlur, Srirangaraj and Govindaraju, Venu},
  booktitle = {Advances in Neural Information Processing Systems},
  year = {2024},
  abbr = {NeurIPS},
  selected = {true},
  bibtex_show = {true},
  html = {https://openreview.net/forum?id=FIs87Iro9j},
  pdf = {https://proceedings.neurips.cc/paper_files/paper/2024/file/81f554467f27759e88de14ba2fbafb47-Paper-Conference.pdf},
  code = {https://github.com/bhavinjawade/ProxyFusion},
  website = {https://bhavinjawade.github.io/proxyfusion_ub/},
  abstract = {Face feature fusion is needed for robust recognition when not every frame of a long-range, low-resolution video is equally informative. ProxyFusion selects a sparse set of pooling experts with learnable proxies and aggregates a variable-size set of face features in linear time. The method is order-invariant, does not need intermediate feature maps or extra face metadata, and can run on legacy biometric templates. Evaluations on IARPA BTS3.1 and DroneSURF show gains for unconstrained long-range face recognition.}
}

@article{urala2019generalized,
  title = {Generalized Framework for Summarization of Fixed-Camera Lecture Videos by Detecting and Binarizing Handwritten Content},
  author = {Urala Kota, Bhargava and Davila, Kenny and Stone, Alexander and Setlur, Srirangaraj and Govindaraju, Venu},
  journal = {International Journal on Document Analysis and Recognition (IJDAR)},
  volume = {22},
  number = {3},
  pages = {221--233},
  year = {2019},
  publisher = {Springer},
  doi = {10.1007/s10032-019-00327-y},
  abbr = {IJDAR},
  selected = {true},
  bibtex_show = {true},
  pdf = {https://par.nsf.gov/servlets/purl/10113241},
  abstract = {A framework for extracting and binarizing handwritten content in fixed-camera lecture videos, so the content can be used to index and navigate the video. A deep learning pipeline detects handwritten text, formulae, and sketches, and the spatio-temporal structure of those detections is used to segment the lecture. On the AccessMath dataset the framework reaches an F-measure of 94.32 percent for binary connected components.}
}

@inproceedings{kota2019summarizing,
  title = {Summarizing Lecture Videos by Key Handwritten Content Regions},
  author = {Kota, Bhargava Urala and Ahmed, Saleem and Stone, Alexander and Davila, Kenny and Setlur, Srirangaraj and Govindaraju, Venu},
  booktitle = {2019 International Conference on Document Analysis and Recognition Workshops (ICDARW)},
  volume = {4},
  pages = {13--18},
  year = {2019},
  organization = {IEEE},
  doi = {10.1109/ICDARW.2019.30058},
  abbr = {ICDARW},
  selected = {true},
  bibtex_show = {true},
  pdf = {https://par.nsf.gov/servlets/purl/10188708},
  note = {Best paper award},
  abstract = {Whiteboard lecture videos are summarized by key handwritten content regions. A detector finds semantically meaningful groups of handwriting, and a triplet-loss embedding distinguishes unique content across frames. A spatiotemporal index maps each summary region back to where it appears in the video. On AccessMath the method recalls 92.09 percent of unique ground-truth objects.}
}

@inproceedings{kota2021automated,
  title = {Automated Whiteboard Lecture Video Summarization by Content Region Detection and Representation},
  author = {Kota, Bhargava Urala and Stone, Alexander and Davila, Kenny and Setlur, Srirangaraj and Govindaraju, Venu},
  booktitle = {2020 25th International Conference on Pattern Recognition (ICPR)},
  pages = {10704--10711},
  year = {2021},
  organization = {IEEE},
  doi = {10.1109/ICPR48806.2021.9412386},
  abbr = {ICPR},
  bibtex_show = {true},
  pdf = {https://par.nsf.gov/servlets/purl/10292303},
  abstract = {Whiteboard lecture videos are summarized by detecting handwritten content regions and comparing their feature representations to find unique content. The method handles occluded, growing, and disappearing handwriting, and produces both key content and keyframes. Weighted spatio-temporal conflict minimization is used to segment the lecture.}
}

